{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(until:*)",
      "Bash(sleep:*)",
      "Bash(git stash:*)",
      "Bash(npm run dev:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Write(./.env)",
      "Write(**/.env)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Write(**/credentials.json)",
      "Read(**/*serviceAccount*.json)",
      "Edit(**/*serviceAccount*.json)",
      "Write(**/*serviceAccount*.json)"
    ]
  }
}
