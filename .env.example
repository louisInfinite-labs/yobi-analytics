# Local development only. A deployed Lambda instead sets
# YOUTUBE_API_KEY_SECRET_NAME (see below) so the key is never stored in
# plaintext Lambda configuration.
YOUTUBE_API_KEY=

# Deployed-Lambda alternative to YOUTUBE_API_KEY above: the name of an AWS
# Secrets Manager secret holding the key. Takes priority over YOUTUBE_API_KEY
# when both are set. Leave unset for local development.
# YOUTUBE_API_KEY_SECRET_NAME=

# Read by the AWS CLI (`aws configure`), not by this project's Python code.
AWS_REGION=ap-northeast-1

# Lambda-only: overrides where video_master.json/snapshots/ are read and
# written. AWS sets this to /tmp (the deployment package itself is read-only).
# Leave unset for local development, where it defaults to src/.
# YOBI_DATA_DIR=/tmp

# Web Push (Roadmap 4.6): path to the VAPID private key PEM file pywebpush
# reads to sign outgoing push notifications. Generate one locally with
# py_vapid (already a pywebpush dependency); the file itself must never be
# committed. When deployed, the Lambda that calls push_sender.py needs this
# same key available (e.g. as a Lambda environment variable or a Secrets
# Manager/SSM entry), not a copy of the file.
VAPID_PRIVATE_KEY_PATH=

# Lambda-only alternative to VAPID_PRIVATE_KEY_PATH above: the PEM content
# itself (e.g. sourced from a Secrets Manager entry), since a deployed
# Lambda's package is read-only and the key must never be committed into
# it. Takes priority over VAPID_PRIVATE_KEY_PATH when both are set.
# VAPID_PRIVATE_KEY=

# The VAPID "sub" claim (RFC 8292): a contact URI push services may use to
# reach you about this application's push traffic — "mailto:you@example.com".
VAPID_CLAIMS_SUB=

# Roadmap 4.5: shared secret required in the X-Admin-Key header for
# POST /remote-config (api_handler.py) — the one write route that authors
# state on behalf of an arbitrary clientId. Generate a long random value;
# never commit the real one. If unset, that route refuses every request
# rather than silently accepting writes with no access control.
YOBI_ADMIN_API_KEY=
