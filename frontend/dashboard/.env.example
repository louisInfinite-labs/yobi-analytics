# Base URL of the deployed Yobi Analytics HTTP API (Roadmap 4.1/4.4/4.5/4.6),
# e.g. https://k76ct6q0j0.execute-api.ap-northeast-1.amazonaws.com — no
# trailing slash. Read at build time by src/lib/apiClient.ts; must be
# prefixed VITE_ to be exposed to client-side code (Vite's own convention).
VITE_API_BASE_URL=

# Firebase App Check (SEC-API-BOT-002). All four are PUBLIC by design (a Firebase web-app config and a reCAPTCHA Enterprise
# site key) and are supplied by the owner at deployment time; leave blank for local development (no token is sent).
# A Firebase web API key is key-shaped, so it must also be listed by EXACT value in scripts/bundle-secret-allowlist.json
# for the bundle secret gate to pass. Never commit real values to this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only (ignored by production builds): an App Check debug token registered in a NON-production project.
# VITE_APPCHECK_DEBUG_TOKEN=
